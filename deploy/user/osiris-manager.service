# Osiris manager (the sacred proc) — systemd USER unit. See docs/SPEC-agent-manager.md
# §1 doctrine 3 (`2ceb7ba0`) and §4.0/§4.8, and src/manager/daemon.py's module docstring.
#
# What this is: the daemon that owns lifecycle for bodies (constitution #2, `f1803b4a` —
# HANDS, ADMITTED AND GOVERNED). It holds HANDLES, never children: every body runs in its
# own transient systemd-run scope (src/orchestrator/bodies.py), outside this unit's own
# cgroup, with its own memory ceiling — so a body dying of OOM cannot take the daemon (or
# anything else) down with it, the exact failure this whole doctrine exists to close
# (`37fe6a09`, the Warp OOM canon). Daemon-death is itself a NORMAL event: on restart it
# rebuilds its world from systemd + the receipts dir + the graph, never from memory — so
# Restart=always is not a crutch, it is the design.
#
# OOMScoreAdjust=-900 + MemoryLow=64M: under system-wide memory pressure the kernel should
# reclaim from bodies (their own scopes, ceilinged) long before it ever looks at the sacred
# proc holding the handles.
#
# A USER unit like deploy/user/osiris-pulse.service and deploy/user/osiris-console.service
# (runs AS the operator, against the operator's own dev instance — no /opt deploy, no system
# account), NOT the /opt system form deploy/osiris-{api,worker}.service use. `osiris deploy`
# installs this file (REBOOT SURVIVAL, thread 194eac83, operator ruling aaa8e841, 2026-09-13:
# this unit sat at the repo root, never actually reached by `osiris deploy`'s own
# deploy/user/*.service glob, until this move) — it is no longer hand-authored or hand-copied.
#
# Adjust WorkingDirectory / the venv path / the URLs to your box. systemd user units do NOT
# inherit your shell PATH, so ExecStart and the venv must be absolute.
[Unit]
Description=Osiris manager (the sacred proc — body adoption, the control socket, the scream)
After=network-online.target docker.service
Wants=network-online.target
# REBOOT SURVIVAL (thread 194eac83): a bare crash-loop restart storm (RestartSec alone) can
# still exhaust systemd's own default 5-tries/10s start-limit and land the unit permanently
# "failed" rather than retrying forever — StartLimitIntervalSec=0 disables that ceiling, so
# postgres coming up slowly after a cold boot (or ever) never permanently strands a daemon
# that would otherwise heal itself the moment its dependency answers.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/code/osiris
# Point at the dev instance (PG :5601 / Redis :6396), inline so the repo's .env is untouched;
# systemd Environment= overrides pydantic's .env. application_name identifies this daemon's
# own connections in pg_stat_activity — asyncpg forwards any DSN query param it doesn't
# recognize straight into server_settings (connect_utils.py), so no code change was needed.
# Added on the move into deploy/user/ (thread 194eac83) to match every sibling unit's own
# convention — the manager's own connections went unlabeled before this.
Environment=DATABASE_URL=postgresql://osiris:osiris@127.0.0.1:5601/osiris?application_name=osiris-manager
Environment=REDIS_URL=redis://127.0.0.1:6396/0
# REBOOT SURVIVAL (thread 194eac83): After=docker.service orders unit *start* correctly, but
# docker's own container health lags its own systemd unit becoming active — postgres/redis
# (docker-compose.full.yml) can take real seconds past that to accept connections. A bare
# bash TCP probe (no extra binary dependency — /dev/tcp is a bash builtin) blocks activation
# until :5601 actually answers, rather than racing it and relying on Restart=always to paper
# over a fast-failing first attempt.
ExecStartPre=/bin/bash -c 'until (echo > /dev/tcp/127.0.0.1/5601) 2>/dev/null; do sleep 1; done'
ExecStart=%h/code/osiris/.venv/bin/python -m src.manager.daemon
Restart=always
RestartSec=2
# The sacred proc survives what its bodies do not: protected against the OOM killer, and
# guaranteed a floor of memory even when the box is under pressure from everything else.
OOMScoreAdjust=-900
MemoryLow=64M

[Install]
WantedBy=default.target
